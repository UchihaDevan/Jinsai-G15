# Configuração do Jinsai-G15 v2.2 (Dell G15 5520)

# Perfil padrão ativo: offline | economy | precision | deepseek_cloud | moe_hybrid
JINSAI_DEFAULT_PROFILE=economy

# Endpoint local do Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Chaves de API para Modelos em Nuvem (Configure conforme o perfil desejado)
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui     # Para Claude 3.7 Sonnet (perfil: precision)
GEMINI_API_KEY=sua_chave_gemini_aqui           # Para Gemini 2.0 Flash (perfil: economy)
DEEPSEEK_API_KEY=sua_chave_deepseek_aqui       # Para DeepSeek-Reasoner API (perfil: deepseek_cloud)
OPENAI_API_KEY=sua_chave_openai_aqui           # Opcional para modelos OpenAI
